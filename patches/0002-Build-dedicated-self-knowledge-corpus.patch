+def build_self_conversation(rng, max_turns=4):
+    """Stack only the model-description turns loaded from YAML."""
+    return "".join(render_seed_turn(rng, SELF_SEED)
+                   for _ in range(rng.randint(1, max_turns))) + "\n"
+
