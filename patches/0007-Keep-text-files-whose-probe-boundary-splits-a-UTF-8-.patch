From ffb8d033cf2fe3970540ec4a693e1cc01e0a0552 Mon Sep 17 00:00:00 2001
From: Helios <11094129+GroveMinting@users.noreply.github.com>
Date: Tue, 13 Oct 2026 22:53:55 -0400
Subject: [PATCH 7/8] Keep text files whose probe boundary splits a UTF-8
 character

Reported as issue #30 by Dshamir: looks_like_text decoded the first 4,096
bytes strictly, so a file whose 4,096th byte fell inside a multi-byte
character raised UnicodeDecodeError and was dropped - from training and
from the held-out set - with no message. Folders heavy in non-ASCII text
lost several percent of their files this way.

Decode incrementally (final=False) so a partial trailing sequence is
buffered rather than treated as an error. A genuinely invalid sequence
earlier in the sample still fails, exactly as before.

Authored here from the report; upstream has no PR for #30.

Co-authored-by: Dshamir <56462162+Dshamir@users.noreply.github.com>
---
 minagi/ingest.py         | 15 +++++++++-
 tests/test_text_probe.py | 59 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 73 insertions(+), 1 deletion(-)
 create mode 100644 tests/test_text_probe.py

diff --git a/minagi/ingest.py b/minagi/ingest.py
index dba15d5..069339c 100644
--- a/minagi/ingest.py
+++ b/minagi/ingest.py
@@ -15,6 +15,7 @@ left alone, because a model that reads a JPEG learns what a JPEG header looks
 like and nothing else useful.
 """
 
+import codecs
 import hashlib
 import json
 import os
@@ -43,9 +44,21 @@ def looks_like_text(path, probe=4096):
     if b"\x00" in head:
         return False
     try:
-        s = head.decode("utf-8")
+        # A character cut in half by the probe boundary is not an error: an
+        # incremental decoder buffers the partial trailing sequence instead of
+        # raising, so a file whose 4,096th byte falls inside a multi-byte
+        # character is still read as text. A genuinely invalid sequence
+        # earlier in the sample still fails, as before.
+        s = codecs.getincrementaldecoder("utf-8")().decode(head, final=False)
     except UnicodeDecodeError:
         return False
+    if not s:
+        # The whole sample is an incomplete multi-byte sequence - a 1-2 byte
+        # file cut inside a character. It decodes to nothing, so there is no
+        # text to judge and it is not text. (Upstream's strict decode called
+        # this a decode error; without this guard the printability ratio
+        # would divide by zero.)
+        return False
     printable = sum(1 for c in s if c.isprintable() or c in "\n\r\t")
     return printable / len(s) > 0.9
 
diff --git a/tests/test_text_probe.py b/tests/test_text_probe.py
new file mode 100644
index 0000000..4764e2f
--- /dev/null
+++ b/tests/test_text_probe.py
@@ -0,0 +1,59 @@
+"""looks_like_text must not reject a text file whose probe boundary cuts a
+multi-byte UTF-8 character in half.
+
+Reported as issue #30 by Dshamir: a strict decode of the first 4,096 bytes
+raised whenever byte 4,096 fell inside a character, and the file was silently
+dropped from training and held-out evaluation. Authored here; upstream has no
+PR for #30.
+"""
+
+import os
+import tempfile
+import unittest
+
+from minagi.ingest import looks_like_text
+
+
+def _write(root, name, data):
+    path = os.path.join(root, name)
+    with open(path, "wb") as f:
+        f.write(data)
+    return path
+
+
+class TextProbeTest(unittest.TestCase):
+    def test_multibyte_char_straddling_the_probe_is_kept(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            # 4,095 ASCII bytes then a 3-byte character: byte 4,096 (0-indexed)
+            # lands inside it.
+            data = b"a" * 4095 + "\u25cf".encode("utf-8") + b"\n"
+            path = _write(tmp, "f.txt", data)
+            with open(path, "rb") as f:
+                head = f.read(4096)
+            with self.assertRaises(UnicodeDecodeError):
+                head.decode("utf-8")           # the old behaviour's trigger
+            self.assertTrue(looks_like_text(path))
+
+    def test_binary_sample_is_still_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = _write(tmp, "blob", b"\x00\x01\x02\xff\xfe" + b"x" * 4096)
+            self.assertFalse(looks_like_text(path))
+
+    def test_truncated_multibyte_file_is_rejected(self):
+        # A 1-2 byte file that is nothing but a UTF-8 lead sequence decodes to
+        # nothing under the incremental decoder. It must be rejected, not
+        # divided by zero (the regression the first cut of this patch had).
+        with tempfile.TemporaryDirectory() as tmp:
+            for name, data in (("one", b"\xe2"), ("two", b"\xe2\x97"),
+                               ("emoji", b"\xf0\x9f")):
+                path = _write(tmp, name, data)
+                self.assertFalse(looks_like_text(path))
+
+    def test_invalid_utf8_is_still_rejected(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = _write(tmp, "bad.txt", b"hello " + b"\xff\xfe" + b"world")
+            self.assertFalse(looks_like_text(path))
+
+
+if __name__ == "__main__":
+    unittest.main()
