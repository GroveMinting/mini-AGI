From 5682a787cb6fde2761e2eff5a4763a4179c8bd63 Mon Sep 17 00:00:00 2001
From: Helios <11094129+GroveMinting@users.noreply.github.com>
Date: Tue, 13 Oct 2026 23:31:42 -0400
Subject: [PATCH 8/8] Auto-detect Apple Silicon (MPS) as a first-class device

From PR #3 by MetalstormHS: --device defaulted to
"cuda" if torch.cuda.is_available() else "cpu", so on Apple Silicon
mini-AGI silently fell back to CPU even though MPS trains fine when passed
explicitly - no signal to the user.

_auto_device() makes CUDA the first choice (the only backend that enables
fused AdamW, bf16 autocast and the VRAM telemetry), MPS the deliberate
second, and CPU the safety net. CUDA and CPU behaviour is byte-identical to
the old inline default. The test asserts the ordering by stubbing both
availability probes, so it holds without CUDA or MPS hardware.

Carried here; upstream has not merged it.

Co-authored-by: MetalstormHS <30507072+MetalstormHS@users.noreply.github.com>
---
 tests/test_device_autodetect.py | 38 +++++++++++++++++++++++++++++++++
 train.py                        | 21 ++++++++++++++++--
 2 files changed, 57 insertions(+), 2 deletions(-)
 create mode 100644 tests/test_device_autodetect.py

diff --git a/tests/test_device_autodetect.py b/tests/test_device_autodetect.py
new file mode 100644
index 0000000..1052e18
--- /dev/null
+++ b/tests/test_device_autodetect.py
@@ -0,0 +1,38 @@
+"""The default --device must prefer CUDA, then MPS, then CPU.
+
+Carried from upstream PR #3 (MetalstormHS): on Apple Silicon the old inline
+default fell back to CPU even though MPS works, with no signal to the user.
+The ordering is asserted here by stubbing the two availability probes, so it
+holds on a machine that has neither backend.
+"""
+
+import unittest
+from unittest import mock
+
+import torch
+
+import train
+
+
+class AutoDeviceTest(unittest.TestCase):
+    def _pick(self, cuda, mps):
+        with mock.patch.object(torch.cuda, "is_available", return_value=cuda), \
+             mock.patch.object(torch.backends.mps, "is_available",
+                               return_value=mps):
+            return train._auto_device()
+
+    def test_cuda_wins_over_mps(self):
+        self.assertEqual(self._pick(True, True), "cuda")
+
+    def test_cuda_when_only_cuda(self):
+        self.assertEqual(self._pick(True, False), "cuda")
+
+    def test_mps_when_no_cuda(self):
+        self.assertEqual(self._pick(False, True), "mps")
+
+    def test_cpu_is_the_fallback(self):
+        self.assertEqual(self._pick(False, False), "cpu")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/train.py b/train.py
index ce08285..406fee2 100644
--- a/train.py
+++ b/train.py
@@ -98,11 +98,28 @@ def _resync_opt(opt, model, args):
                              "weight_decay": args.wd,
                              "lr": base, "base_lr": base})
     if vecs:
-        opt.add_param_group({"params": vecs, "name": "pool",
+         opt.add_param_group({"params": vecs, "name": "pool",
                              "weight_decay": 0.0,
                              "lr": base, "base_lr": base})
 
 
+def _auto_device():
+    """The accelerator to use when the caller did not name one.
+
+    CUDA first: it is the only backend that turns on fused AdamW, bf16
+    autocast and the VRAM telemetry, so a box that has it should train there.
+    MPS next: Apple Silicon can train, but those three CUDA-only paths stay
+    off, so it is a deliberate second choice rather than an accidental one.
+    CPU last: every machine has one, which is why it was the old fallback and
+    why it stays the safety net.
+    """
+    if torch.cuda.is_available():
+        return "cuda"
+    if torch.backends.mps.is_available():
+        return "mps"
+    return "cpu"
+
+
 def cmd_stream(args):
     """
     Train the way the model runs: batch 1, a KV cache, one chunk at a time.
@@ -2019,7 +2036,7 @@ def main():
     ap = argparse.ArgumentParser(
         description="train mini-AGI: read files continually, or stream a "
                     "packed corpus. Batch 1, cached, chunked, either way")
-    ap.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
+    ap.add_argument("--device", default=_auto_device())
     sub = ap.add_subparsers(dest="cmd", required=True)
 
     rd = sub.add_parser("read",
